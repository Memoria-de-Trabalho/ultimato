{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucasrafaldini.github.io/schemas/o-ultimo-curso/curriculum.schema.json",
  "title": "O Último Curso: Schema Curricular",
  "description": "Schema oficial para validação e renderização do currículo interdisciplinar O Último Curso em frontends estáticos (GitHub Pages / Memória de Trabalho).",
  "type": "object",
  "required": [
    "metadata",
    "languageNotice",
    "axes",
    "cycles"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "title",
        "subtitle",
        "version",
        "language",
        "totalHours",
        "repository",
        "hosting"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "const": "pt-BR"
        },
        "totalHours": {
          "type": "integer",
          "minimum": 1
        },
        "lastUpdated": {
          "type": "string",
          "format": "date"
        },
        "repository": {
          "type": "string"
        },
        "hosting": {
          "type": "object",
          "properties": {
            "portfolioGatewayUrl": {
              "type": "string"
            },
            "authenticatedViewerUrl": {
              "type": "string"
            },
            "authMode": {
              "type": "string",
              "enum": [
                "webcrypto-aes-gcm",
                "session-gate"
              ]
            }
          }
        }
      }
    },
    "languageNotice": {
      "type": "object",
      "required": [
        "badgeText",
        "bannerMessage"
      ],
      "properties": {
        "badgeText": {
          "type": "string"
        },
        "bannerMessage": {
          "type": "string",
          "const": "Aviso de Idioma: Este currículo e todos os seus recursos de apoio foram estruturados exclusivamente em Português (PT-BR)."
        }
      }
    },
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "color",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "cycles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "title",
          "slug",
          "estimatedHours",
          "status",
          "objective",
          "modules"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "estimatedHours": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "in_progress",
              "completed"
            ]
          },
          "objective": {
            "type": "string"
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "title",
                "slug",
                "axisId",
                "estimatedHours",
                "status",
                "progressPercent",
                "prerequisites",
                "tags",
                "keyTopics",
                "primaryResources",
                "capstoneProject",
                "markdownPath"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^MOD-[1-3][0-9]{2}$"
                },
                "title": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                },
                "axisId": {
                  "type": "string"
                },
                "secondaryAxisIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "estimatedHours": {
                  "type": "integer"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "not_started",
                    "in_progress",
                    "completed",
                    "review"
                  ]
                },
                "progressPercent": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "prerequisites": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "keyTopics": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "primaryResources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "title",
                      "type",
                      "provider",
                      "url",
                      "language",
                      "isFree"
                    ],
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "course",
                          "book",
                          "guide",
                          "documentation",
                          "video_series"
                        ]
                      },
                      "provider": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      },
                      "language": {
                        "type": "string",
                        "const": "pt-BR"
                      },
                      "isFree": {
                        "type": "boolean",
                        "const": true
                      }
                    }
                  }
                },
                "capstoneProject": {
                  "type": "object",
                  "required": [
                    "title",
                    "description",
                    "deliverables",
                    "evaluationCriteria"
                  ],
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "deliverables": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "evaluationCriteria": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "repositoryPath": {
                      "type": "string"
                    }
                  }
                },
                "markdownPath": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
